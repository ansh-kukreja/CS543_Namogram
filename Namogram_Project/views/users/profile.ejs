<% layout("/layouts/boilerplate.ejs") %>

<div class="profile-container">
  <% if (error) { %>
    <div class="custom-card text-center py-5 my-4">
      <i class="fa-solid fa-triangle-exclamation fa-3x text-warning mb-3"></i>
      <h4 class="text-white">User Not Found</h4>
      <p class="text-muted mb-4">The profile you are looking for does not exist or has been removed.</p>
      <a href="/posts" class="btn btn-primary-custom">Return to Home Feed</a>
    </div>
  <% } else { 
      const isOwnProfile = currUser && currUser.username === profileUser.username;
      const followersList = profileUser.followers || [];
      const followingList = profileUser.following || [];
      const isCreator = profileUser.accountType === 'creator';
  %>
    <!-- Profile Header Card -->
    <header class="profile-header-card">
      <div class="profile-avatar-fallback-large">
        <%= profileUser.username.charAt(0).toUpperCase() %>
      </div>

      <div class="profile-details">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
          <div class="d-flex align-items-center gap-2">
            <h2 class="profile-username-title mb-0">@<%= profileUser.username %></h2>
            <% if (isCreator) { %>
              <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-1 small">
                <i class="fa-solid fa-wand-magic-sparkles me-1"></i> Creator
              </span>
            <% } %>
          </div>

          <!-- Actions -->
          <div class="d-flex align-items-center gap-2">
            <% if (isOwnProfile) { %>
              <% if (isCreator) { %>
                <a href="/profile/analytics" class="btn btn-outline-custom btn-sm">
                  <i class="fa-solid fa-chart-pie me-1"></i> Profile Analytics
                </a>
              <% } %>

              <button type="button" class="btn btn-outline-custom btn-sm" data-bs-toggle="modal" data-bs-target="#editProfileModal">
                <i class="fa-solid fa-pen-to-square me-1"></i> Edit Profile
              </button>

              <a href="/posts/new" class="btn btn-primary-custom btn-sm">
                <i class="fa-solid fa-plus me-1"></i> New Post
              </a>

              <!-- Account Settings Dropdown (Infrequent Switcher) -->
              <div class="dropdown">
                <button 
                  class="btn btn-outline-custom btn-sm px-2" 
                  type="button" 
                  data-bs-toggle="dropdown" 
                  aria-expanded="false" 
                  title="Account Settings"
                >
                  <i class="fa-solid fa-gear"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow">
                  <li><h6 class="dropdown-header text-uppercase small text-muted">Account Type</h6></li>
                  <% if (isCreator) { %>
                    <li>
                      <button class="dropdown-item py-2" type="button" id="btnSwitchPrivate">
                        <i class="fa-solid fa-user me-2 text-secondary"></i> Switch to Private Account
                      </button>
                    </li>
                  <% } else { %>
                    <li>
                      <button class="dropdown-item py-2" type="button" id="btnSwitchCreator">
                        <i class="fa-solid fa-wand-magic-sparkles me-2 text-primary"></i> Switch to Creator Account
                      </button>
                    </li>
                  <% } %>
                  <li><hr class="dropdown-divider border-secondary opacity-25"></li>
                  <li>
                    <a class="dropdown-item text-danger py-2" href="/logout">
                      <i class="fa-solid fa-arrow-right-from-bracket me-2"></i> Log Out
                    </a>
                  </li>
                </ul>
              </div>
            <% } else { %>
              <!-- Follow / Unfollow Button -->
              <button 
                type="button" 
                class="btn-follow <%= isFollowing ? 'following' : '' %>" 
                id="followBtn"
                data-username="<%= profileUser.username %>"
              >
                <%= isFollowing ? 'Following' : 'Follow' %>
              </button>
            <% } %>
          </div>
        </div>

        <!-- Metrics Statistics Dashboard Tiles (Distinct, Non-Instagram Layout) -->
        <div class="profile-stats-grid mb-3">
          <div class="profile-stat-tile">
            <span class="stat-number"><%= posts.length %></span>
            <span class="stat-title">Posts</span>
          </div>

          <button type="button" class="profile-stat-tile btn-stat-modal" data-bs-toggle="modal" data-bs-target="#followersModal">
            <span class="stat-number" id="followersCountVal"><%= followersList.length %></span>
            <span class="stat-title">Followers</span>
          </button>

          <button type="button" class="profile-stat-tile btn-stat-modal" data-bs-toggle="modal" data-bs-target="#followingModal">
            <span class="stat-number" id="followingCountVal"><%= followingList.length %></span>
            <span class="stat-title">Following</span>
          </button>

          <div class="profile-stat-tile">
            <span class="stat-number"><%= totalLikes %></span>
            <span class="stat-title">Likes</span>
          </div>
        </div>

        <!-- Bio & Account Status -->
        <div class="profile-bio">
          <p class="mb-0 text-secondary"><%= profileUser.bio || "Welcome to my NamoGram gallery!" %></p>
          
          <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
            <% if (profileUser.age) { %>
              <span class="badge bg-dark border border-secondary text-info">
                <i class="fa-solid fa-cake-candles me-1"></i><%= profileUser.age %> yrs
              </span>
            <% } %>
            <% if (profileUser.gender && profileUser.gender !== 'unspecified') { %>
              <span class="badge bg-dark border border-secondary text-capitalize text-info">
                <i class="fa-solid fa-user me-1"></i><%= profileUser.gender %>
              </span>
            <% } %>
          </div>

          <% if (isOwnProfile) { %>
            <div class="account-type-status-note small text-secondary mt-2 d-flex align-items-center gap-2">
              <span>Account Type: <strong class="text-white"><%= isCreator ? 'Creator Account' : 'Private Account' %></strong></span>
              &bull;
              <button 
                type="button" 
                class="btn btn-link btn-sm text-primary p-0 text-decoration-none small"
                id="btnQuickToggleAccount"
                data-target-type="<%= isCreator ? 'private' : 'creator' %>"
              >
                Switch to <%= isCreator ? 'Private' : 'Creator' %>
              </button>
            </div>
          <% } %>
        </div>
      </div>
    </header>

    <!-- Post Grid Section -->
    <div class="mb-3 d-flex align-items-center justify-content-between">
      <h5 class="text-white mb-0 fw-semibold">
        <i class="fa-solid fa-table-cells text-primary me-2"></i>Posts
      </h5>
      <span class="text-secondary small"><%= posts.length %> <%= posts.length === 1 ? 'post' : 'posts' %></span>
    </div>

    <% if (posts.length === 0) { %>
      <div class="custom-card text-center py-5">
        <i class="fa-regular fa-images fa-3x text-secondary mb-3"></i>
        <h5 class="text-white">No Posts Yet</h5>
        <p class="text-secondary small mb-3">
          <%= isOwnProfile ? "You haven't shared any posts yet. Start by creating one!" : "This user has not posted anything yet." %>
        </p>
        <% if (isOwnProfile) { %>
          <a href="/posts/new" class="btn btn-primary-custom">
            <i class="fa-solid fa-plus me-1"></i> Create Your First Post
          </a>
        <% } %>
      </div>
    <% } else { %>
      <div class="profile-grid">
        <% for (let post of posts) { %>
          <a href="/posts/<%= post._id %>" class="profile-grid-item text-decoration-none">
            <img 
              src="<%= post.image %>" 
              alt="<%= post.caption || 'User post' %>" 
              class="profile-grid-img"
              loading="lazy"
              onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=900&auto=format&fit=crop';"
            >
            <div class="profile-grid-overlay">
              <span>
                <i class="fa-solid fa-heart me-1 text-primary"></i> 
                <%= post.likes ? post.likes.length : 0 %>
              </span>
              <% if (post.tags && post.tags.length > 0) { %>
                <span>
                  <i class="fa-solid fa-hashtag me-1 text-info"></i> 
                  <%= post.tags[0] %>
                </span>
              <% } %>
            </div>
          </a>
        <% } %>
      </div>
    <% } %>

    <!-- Modal for Followers List -->
    <div class="modal fade" id="followersModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content custom-dark-modal">
          <div class="modal-header">
            <h5 class="modal-title">Followers (<%= followersList.length %>)</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body" id="followersModalBody">
            <% if (followersList.length === 0) { %>
              <div class="text-muted text-center py-4">No followers yet.</div>
            <% } else { %>
              <% for (let fUser of followersList) { %>
                <div class="likes-user-row">
                  <div class="likes-user-left">
                    <div class="likes-user-avatar"><%= fUser.charAt(0).toUpperCase() %></div>
                    <a href="/profile/<%= fUser %>" class="likes-user-name">@<%= fUser %></a>
                  </div>
                  <a href="/profile/<%= fUser %>" class="btn btn-outline-custom btn-sm">View Profile</a>
                </div>
              <% } %>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Modal for Following List -->
    <div class="modal fade" id="followingModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content custom-dark-modal">
          <div class="modal-header">
            <h5 class="modal-title">Following (<%= followingList.length %>)</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <% if (followingList.length === 0) { %>
              <div class="text-muted text-center py-4">Not following anyone yet.</div>
            <% } else { %>
              <% for (let fUser of followingList) { %>
                <div class="likes-user-row">
                  <div class="likes-user-left">
                    <div class="likes-user-avatar"><%= fUser.charAt(0).toUpperCase() %></div>
                    <a href="/profile/<%= fUser %>" class="likes-user-name">@<%= fUser %></a>
                  </div>
                  <a href="/profile/<%= fUser %>" class="btn btn-outline-custom btn-sm">View Profile</a>
                </div>
              <% } %>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Modal for Edit Profile -->
    <% if (isOwnProfile) { %>
      <div class="modal fade" id="editProfileModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content custom-dark-modal">
            <div class="modal-header">
              <h5 class="modal-title"><i class="fa-solid fa-pen-to-square me-2 text-primary"></i>Edit Profile</h5>
              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="/profile/edit" method="POST">
              <div class="modal-body">
                <div class="mb-3">
                  <label for="editBio" class="form-label text-secondary small">Bio</label>
                  <textarea 
                    name="bio" 
                    id="editBio" 
                    rows="3" 
                    class="form-control bg-dark text-white border-secondary"
                    maxlength="150"
                  ><%= profileUser.bio || "" %></textarea>
                  <small class="text-secondary">Brief description about yourself (max 150 chars)</small>
                </div>

                <div class="row g-2">
                  <div class="col-6 mb-3">
                    <label for="editAge" class="form-label text-secondary small">Age</label>
                    <input 
                      type="number" 
                      name="age" 
                      id="editAge" 
                      class="form-control bg-dark text-white border-secondary"
                      min="13" 
                      max="120"
                      value="<%= profileUser.age || 22 %>"
                    />
                  </div>
                  <div class="col-6 mb-3">
                    <label for="editGender" class="form-label text-secondary small">Gender</label>
                    <select name="gender" id="editGender" class="form-select bg-dark text-white border-secondary">
                      <option value="unspecified" <%= (!profileUser.gender || profileUser.gender === 'unspecified') ? 'selected' : '' %>>Prefer not to say</option>
                      <option value="female" <%= profileUser.gender === 'female' ? 'selected' : '' %>>Female</option>
                      <option value="male" <%= profileUser.gender === 'male' ? 'selected' : '' %>>Male</option>
                      <option value="other" <%= profileUser.gender === 'other' ? 'selected' : '' %>>Other</option>
                    </select>
                  </div>
                </div>
              </div>
              <div class="modal-footer border-secondary border-opacity-25">
                <button type="button" class="btn btn-outline-custom btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary-custom btn-sm px-3">Save Changes</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    <% } %>

  <% } %>
</div>
