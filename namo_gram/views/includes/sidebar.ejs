<!-- Desktop Sidebar -->
<aside class="sidebar-container d-none d-md-flex">
  <div class="sidebar-brand-box">
    <a href="/posts" class="sidebar-brand">
      <%- include("logo.ejs", { size: 36 }) %>
      <span class="sidebar-brand-text">NamoGram</span>
    </a>
  </div>

  <nav class="sidebar-nav">
    <a href="/posts" class="sidebar-link <%= (activePath === '/posts' || activePath === '/') ? 'active' : '' %>">
      <i class="fa-solid fa-house sidebar-icon"></i>
      <span class="sidebar-text">Home</span>
    </a>

    <a href="/search" class="sidebar-link <%= activePath === '/search' ? 'active' : '' %>">
      <i class="fa-solid fa-magnifying-glass sidebar-icon"></i>
      <span class="sidebar-text">Search</span>
    </a>

    <a href="/posts/new" class="sidebar-link <%= activePath === '/posts/new' ? 'active' : '' %>">
      <i class="fa-regular fa-square-plus sidebar-icon"></i>
      <span class="sidebar-text">Create</span>
    </a>

    <a href="/profile" class="sidebar-link <%= (activePath.startsWith('/profile') && (typeof profileUser === 'undefined' || !profileUser || profileUser.username === currUser.username)) ? 'active' : '' %>">
      <i class="fa-regular fa-circle-user sidebar-icon"></i>
      <span class="sidebar-text">Profile</span>
    </a>
  </nav>

  <div class="sidebar-bottom">
    <a href="/about" class="sidebar-link <%= activePath === '/about' ? 'active' : '' %>">
      <i class="fa-solid fa-circle-info sidebar-icon"></i>
      <span class="sidebar-text">About NamoGram</span>
    </a>

    <a href="/logout" class="sidebar-link logout-link">
      <i class="fa-solid fa-arrow-right-from-bracket sidebar-icon"></i>
      <span class="sidebar-text">Logout</span>
    </a>
  </div>
</aside>

<!-- Mobile Navigation Bar -->
<div class="mobile-bottom-nav d-flex d-md-none">
  <a href="/posts" class="mobile-nav-link <%= (activePath === '/posts' || activePath === '/') ? 'active' : '' %>">
    <i class="fa-solid fa-house"></i>
  </a>
  <a href="/search" class="mobile-nav-link <%= activePath === '/search' ? 'active' : '' %>">
    <i class="fa-solid fa-magnifying-glass"></i>
  </a>
  <a href="/posts/new" class="mobile-nav-link <%= activePath === '/posts/new' ? 'active' : '' %>">
    <i class="fa-regular fa-square-plus"></i>
  </a>
  <a href="/profile" class="mobile-nav-link <%= activePath.startsWith('/profile') ? 'active' : '' %>">
    <i class="fa-regular fa-circle-user"></i>
  </a>
  <a href="/about" class="mobile-nav-link <%= activePath === '/about' ? 'active' : '' %>">
    <i class="fa-solid fa-circle-info"></i>
  </a>
  <a href="/logout" class="mobile-nav-link logout-link">
    <i class="fa-solid fa-arrow-right-from-bracket"></i>
  </a>
</div>
