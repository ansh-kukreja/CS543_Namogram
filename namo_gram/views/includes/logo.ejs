<% 
  const logoSize = typeof size !== 'undefined' ? size : 34; 
%>
<svg class="namogram-logo-svg" width="<%= logoSize %>" height="<%= logoSize %>" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="namoBlueGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00d2ff" />
      <stop offset="50%" stop-color="#0095f6" />
      <stop offset="100%" stop-color="#1d4ed8" />
    </linearGradient>
    <linearGradient id="namoBgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#111827" />
      <stop offset="100%" stop-color="#030712" />
    </linearGradient>
    <filter id="namoGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="0" stdDeviation="2.5" flood-color="#0095f6" flood-opacity="0.6"/>
    </filter>
  </defs>
  <!-- Base Badge -->
  <rect x="2.5" y="2.5" width="39" height="39" rx="12" fill="url(#namoBgGrad)" stroke="url(#namoBlueGrad)" stroke-width="2.5" />
  
  <!-- Stylized Monogram N & Spark Nodes -->
  <path d="M13 31V13L24 26.5V13M31 13V31" stroke="url(#namoBlueGrad)" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" filter="url(#namoGlow)" />
  <circle cx="13" cy="13" r="2.2" fill="#00d2ff" />
  <circle cx="31" cy="31" r="2.2" fill="#00d2ff" />
</svg>
