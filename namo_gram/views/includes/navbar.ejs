<nav class="top-auth-navbar">
  <div class="container d-flex justify-content-between align-items-center">
    <a href="<%= currUser ? '/posts' : '/login' %>" class="top-nav-brand d-flex align-items-center gap-2">
      <%- include("logo.ejs", { size: 32 }) %>
      <span class="top-nav-brand-text">NamoGram</span>
    </a>

    <div class="top-nav-actions d-flex align-items-center gap-3">
      <a href="/about" class="nav-text-link <%= activePath === '/about' ? 'active-link' : '' %>">
        About NamoGram
      </a>

      <% if (!currUser) { %>
        <a href="/login" class="btn btn-outline-custom <%= activePath === '/login' ? 'active' : '' %>">
          Log In
        </a>
        <a href="/signup" class="btn btn-primary-custom <%= activePath === '/signup' ? 'active' : '' %>">
          Sign Up
        </a>
      <% } else { %>
        <a href="/posts" class="btn btn-primary-custom">
          Go to Feed
        </a>
        <a href="/logout" class="btn btn-outline-custom">
          Logout
        </a>
      <% } %>
    </div>
  </div>
</nav>